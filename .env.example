# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRY_HOURS=8

# Database: leave all blank for a zero-setup local SQLite demo, OR use MySQL:
# DATABASE_URL=mysql+pymysql://urja_user:password@localhost:3306/urjasense?charset=utf8mb4
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=urjasense

# Server
HOST=127.0.0.1
PORT=5000
FORCE_HTTPS=0                # set 1 behind an HTTPS load balancer / API Gateway
CORS_ORIGINS=*               # restrict to your frontend origin in production
RATE_LIMIT_ENABLED=1
MAX_REPORTS_PER_USER_PER_HOUR=5

# Duplicate detection tuning
DUP_TIME_WINDOW_MIN=180
DUP_MATCH_THRESHOLD=0.55

# AWS (optional - nothing calls AWS unless SNS_ENABLED=1 and credentials exist)
SNS_ENABLED=0
SNS_TOPIC_ARN=
AWS_REGION=ap-south-1
